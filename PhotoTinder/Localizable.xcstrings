    "Swipe left to delete, right to keep. PhotoTinder remembers every decision, so you never review the same photo twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links wischen zum Löschen, nach rechts zum Behalten. PhotoTinder merkt sich jede Entscheidung – du siehst dasselbe Foto nie zweimal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para eliminar y a la derecha para conservar. PhotoTinder recuerda cada decisión, así que nunca revisas la misma foto dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaie vers la gauche pour supprimer, vers la droite pour garder. PhotoTinder retient chaque choix : tu ne reverras jamais la même photo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para excluir e para a direita para manter. O PhotoTinder lembra cada decisão, então você nunca revisa a mesma foto duas vezes."
          }
        }
      }
    },
    "Swipe some photos on the Swipe tab. Anything you mark for deletion — or keep this session — will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische ein paar Fotos im Tab „Wischen“. Alles, was du in dieser Sitzung zum Löschen oder Behalten markierst, erscheint hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza algunas fotos en la pestaña Deslizar. Lo que marques para eliminar o conservar en esta sesión aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
