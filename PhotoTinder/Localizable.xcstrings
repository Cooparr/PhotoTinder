    "PhotoTinder needs access to your photo library to work. Turn it on in Settings and come back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoTinder braucht Zugriff auf deine Fotomediathek. Aktiviere ihn in den Einstellungen und komm zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoTinder necesita acceso a tu fototeca para funcionar. Actívalo en Ajustes y vuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
