    "I'm using PhotoTinder to clean up my photo library — swipe left to trash, right to keep. Check it out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich nutze PhotoTinder, um meine Fotomediathek aufzuräumen – nach links wischen zum Löschen, nach rechts zum Behalten. Schau mal rein!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy usando PhotoTinder para ordenar mi fototeca: desliza a la izquierda para tirar y a la derecha para conservar. Échale un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'utilise PhotoTinder pour nettoyer ma bibliothèque de photos — balaie vers la gauche pour supprimer, vers la droite pour garder. Jette un œil !"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estou usando o PhotoTinder para organizar minha biblioteca de fotos — deslize para a esquerda para excluir e para a direita para manter. Confira!"
          }
        }
      }
    },
